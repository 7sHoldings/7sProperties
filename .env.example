# Copy this to .env.local and fill in your project values.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# Service-role key — Dashboard → Project Settings → API.
# Used ONLY by the Stripe webhook handler to write across owners
# (Stripe calls us with no user cookie). Keep this server-side; never expose
# it to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Stripe — Dashboard → Developers → API keys
# Use the test keys (sk_test_..., pk_test_...) until you're ready for production.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret — Dashboard → Developers → Webhooks → Your endpoint
# Subscribe the endpoint to these events:
#   payment_intent.succeeded
#   payment_intent.processing
#   payment_intent.payment_failed
#   payment_intent.canceled
#   invoice.paid
#   invoice.payment_succeeded
#   invoice.payment_failed
#   setup_intent.succeeded
# For local development run:  stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
